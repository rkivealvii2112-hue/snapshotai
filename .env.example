# ═══════════════════════════════════════════════════════════════════
# SERVER-SIDE keys  →  used ONLY by the /api relay functions.
# Set these in your Vercel project dashboard (or in .env.local for
# `vercel dev`). They are NEVER shipped to the browser.
# (For local `npm run dev` they are also picked up by .env/.env.local.)
# ═══════════════════════════════════════════════════════════════════

# Powers STAGE 1 via the relay → visitors need no key.
# Tries OWL-ViT first; if HF's serverless provider has retired it (HTTP 400
# "Model not supported by provider hf-inference" / 404) it automatically falls
# back to zero-shot detection through the OpenAI-compatible chat router.
# Create at https://huggingface.co/settings/tokens ("Inference Providers" permission)
HF_TOKEN=

# Powers STAGE 2 (Gemini) via the relay.
# Create at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional server overrides
# HF_ENDPOINT=https://router.huggingface.co/hf-inference/models/google/owlvit-base-patch32
# HF_CHAT_ENDPOINT=https://router.huggingface.co/v1/chat/completions
# GEMINI_MODEL=gemini-3.8-flash   # first entry of the chain: 1.5 → 3.8 → 2.5 → 2.0

# ═══════════════════════════════════════════════════════════════════
# CLIENT-SIDE overrides  →  ⚠ LOCAL DEV ONLY ⚠
# Anything prefixed VITE_ is baked into the PUBLIC JavaScript bundle.
# Never put real keys here for a public deployment — use the relay above.
# ═══════════════════════════════════════════════════════════════════
# VITE_HF_TOKEN=
# VITE_GEMINI_API_KEY=
# VITE_HF_ENDPOINT=
# VITE_GEMINI_MODEL=
