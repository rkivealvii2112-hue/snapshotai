# ─── SpaceSnap AI keys ───────────────────────────────────────────────
# Hugging Face access token — create at https://huggingface.co/settings/tokens
# (needs the "Inference Providers" permission). Powers STAGE 1 (OWL-ViT).
VITE_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google AI Studio (Gemini) API key — https://aistudio.google.com/app/apikey
# Powers STAGE 2 (vision-language explanation).
VITE_GEMINI_API_KEY=

# ─── Optional overrides ──────────────────────────────────────────────
# VITE_HF_ENDPOINT=https://router.huggingface.co/hf-inference/models/google/owlvit-base-patch32
# VITE_GEMINI_MODEL=gemini-1.5-flash
